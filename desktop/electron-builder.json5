// Aitzaz AI Pro — desktop shell packaging config.
// See https://www.electron.build/configuration/configuration
{
  appId: 'ai.aitzaz.hud',
  productName: 'Aitzaz AI Pro',
  copyright: 'Aitzaz',
  asar: true,
  directories: {
    output: 'release/${version}',
    buildResources: 'build',
  },
  files: ['main.js', 'preload.js', 'config.html', 'offline.html', 'build/icon.png'],
  publish: [
    {
      provider: 'github',
      owner: 'muhammadlai',
      repo: 'Aitzaz-OS',
      releaseType: 'release',
    },
  ],
  win: {
    target: [{ target: 'nsis', arch: ['x64'] }],
    icon: 'build/icon.png',
    artifactName: 'Aitzaz-AI-Pro-Windows-${version}-Setup.${ext}',
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  mac: {
    target: [{ target: 'dmg', arch: ['x64', 'arm64'] }],
    category: 'public.app-category.utilities',
    icon: 'build/icon.png',
    artifactName: 'Aitzaz-AI-Pro-Mac-${version}.${ext}',
  },
  linux: {
    target: [
      { target: 'AppImage', arch: ['x64', 'arm64'] },
      { target: 'deb', arch: ['x64', 'arm64'] },
    ],
    category: 'Utility',
    icon: 'build/icon.png',
    maintainer: 'Aitzaz',
    synopsis: 'Desktop shell for the Aitzaz AI voice HUD',
    description:
      'Aitzaz AI Pro connects to your self-hosted Aitzaz/Hermes voice pipeline server over the LAN and shows the full AI-core HUD in a native desktop window. Works on Windows, macOS, Linux, and (via the Linux environment) Chromebooks.',
    artifactName: 'Aitzaz-AI-Pro-Linux-${version}-${arch}.${ext}',
  },
}
